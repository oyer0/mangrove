name=view
category=files
description=read a text file in the fullscreen viewer
usage=view FILE
option=-h, --help     show this quick help
keybinding=j / Down, k / Up    scroll by one visual row
keybinding=Page Up/Down    move by one viewport; Space moves down
keybinding=g / Home    move to the beginning of the document
keybinding=G / End    move to the end of the document
keybinding=?    open incremental literal search
keybinding=n / b    during search, move to the next / previous match without wrapping
keybinding=q    close the viewer
keybinding=Escape    cancel search, leave search mode, or close the viewer

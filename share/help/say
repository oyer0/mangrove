name=say
category=system
description=print text with optional backslash escape translation
usage=say [-e|--escapes] [-n|--no-newline] [--] [text ...]
option=-h, --help    show this help
option=-e, --escapes translate supported backslash escapes before writing
option=-n, --no-newline    omit the final newline
note=-e translates \\, \n, \r, \t, and \e; without it, backslashes stay literal.
note=-n suppresses the final newline. Redirected output receives emitted bytes unchanged.

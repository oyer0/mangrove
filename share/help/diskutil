name=diskutil
category=system
description=protected interactive disk inspection and management utility; storage authorization is required to enter
usage=diskutil
option=-h, --help    show this help
command=list    list whole disks or the selected disk's partitions
command=select <disk>    select a whole disk
command=info    show general or selected disk properties
command=format <target> <fat32|mgfs|exfat>    format a disk or partition
command=label <target> <label>    change a filesystem label
command=initialize gpt    create a fresh GPT
command=create <size|rest>    create a GPT partition
command=delete <partN>    delete a GPT partition
command=back    return to the disk list
command=help    show commands available in the current state
command=exit    leave diskutil
note=Destructive operations require storage authorization and exact typed confirmation.
note=Mounted, read-only, system-managed, or changed targets are rejected; whole-disk formatting requires no partitions.

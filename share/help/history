name=history
category=system
description=manage command history
usage=history [-c|-a|-n|-r|-w|-d N]
option=-c            clear only current in-memory history
option=-d N          delete numbered entry N from memory
option=-a            append unsaved session commands
option=-n            import reliably new saved entries; warn on ambiguous changes
option=-r            import all saved entries, allowing duplicates
option=-w            replace saved history with current memory; resolve uncertain writes

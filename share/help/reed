name=reed
category=files
description=modal text editor
usage=reed [FILE]
option=-h, --help        show this quick help
keybinding=Normal / Selection: h/j/k/l or arrows; b/B/n/N move by word
keybinding=a/e, Home/End line edges; A/E also enter Insert; g/G, Ctrl+Home/End document edges
keybinding=[ / ] move by paragraph; Page Up/Down move by viewport
keybinding=s/S select characters/lines; Alt+S selects all; Selection d deletes it
keybinding=Normal: d deletes at cursor; Backspace/Delete delete before/at; u/U undo/redo
keybinding=Normal: i enters Insert; o/O open a line below/above
keybinding=Insert: arrows move; Backspace/Delete edit; Escape returns to Normal; / opens command entry; ? starts search
keybinding=Search prompt: Backspace/Delete edit query; Enter accepts; Escape cancels; Search: n/b move matches; ?/Escape exits
command=/s    save the current file
command=/q    quit with unsaved-change protection
command=/sq    save and quit only after a successful save
command=/saveas PATH    save as without replacing an existing file
command=/open PATH    open another file
command=/find TEXT    search forward for literal text
note=See info reed for the complete key reference, configuration, and file limits.

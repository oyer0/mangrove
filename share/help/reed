name=reed
category=files
description=modal text editor
usage=reed [FILE]
option=FILE             open a file or start a buffer for it
option=/s                save the current file
option=/q                quit with unsaved-change protection
option=/sq               save and quit only after a successful save
option=/saveas PATH      save to a new path without replacing an existing file
option=/open PATH        open another file
option=/find TEXT        search forward for literal text
option=-h, --help        show this quick help
